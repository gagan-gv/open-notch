[Unit]
Description=OpenNotch - Dynamic Desktop Notch Overlay
Documentation=https://github.com/chordiagagan/open-notch
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/open-notch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
